package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;

// import java.io.*;
import rs.ac.bg.etf.pp1.ast.*;


parser code {:
	
	boolean errorDetected = false;
	
	Logger log = Logger.getLogger(getClass());
   
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }
    
    public void report_info(String message, Object info) {
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.info(msg.toString());
    }
    
:}

scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}

terminal PROG, LBRACE, RBRACE;
terminal COMMA, SEMI, LBRACKET, RBRACKET;
terminal String IDENT;
terminal Integer NUMBER;
terminal Character CHARACTER;
terminal Integer BOOL;
terminal CONST, EQUAL;
terminal ENUM;
terminal LPAREN, RPAREN;
terminal VOID;
terminal IF, ELSE;
terminal BREAK, CONTINUE, RETURN;
terminal READ, PRINT;
terminal FOR, SWITCH, CASE;
terminal COLON;
terminal INC, DEC, OR, AND, QUESTION, MINUS;
terminal PLUS, MUL, DIV, MOD;
terminal EQ, NE, GT, GE, LT, LE;
terminal DOT;
terminal NEW;
terminal LENGTH;


nonterminal Program Program;
nonterminal ProgramName ProgramName;

nonterminal ConVarEnumDecList ConVarEnumDecList;
nonterminal ConDecList ConDecList;
nonterminal ConDecl ConDecl;
nonterminal ConDeclMore ConDeclMore;
nonterminal Constant Constant;

nonterminal VarDeclList VarDeclList;
nonterminal VarIdent VarIdent;
nonterminal VarIdentList VarIdentList;


nonterminal MethodDeclList MethodDeclList;
nonterminal MethodDecl MethodDecl;

nonterminal EnumItemList EnumItemList;
nonterminal EnumDecl EnumDecl;
nonterminal EnumItem EnumItem;

nonterminal FormParList FormParList;
nonterminal FormParMore FormParMore;
nonterminal FormPar FormPar;
nonterminal VarDeclListPom VarDeclListPom;

nonterminal Statement Statement;
nonterminal StatementElse StatementElse;
nonterminal Statements Statements;
nonterminal SimpleStatement SimpleStatement;
nonterminal StatementList StatementList;
nonterminal ForInit ForInit;
nonterminal ForCond ForCond;
nonterminal ForStep ForStep;
nonterminal CaseList CaseList;
nonterminal CaseBlock CaseBlock;

nonterminal Condition Condition;
nonterminal DesignatorStatement DesignatorStatement;
nonterminal Assignop Assignop;
nonterminal ActPars ActPars;
nonterminal ActParsMore ActParsMore;
nonterminal CondTerm CondTerm;
nonterminal CondFact CondFact;
nonterminal Relop Relop;
nonterminal Addop Addop;
nonterminal Mulop Mulop;
nonterminal FactorOptActPars FactorOptActPars;
nonterminal Pom Pom;
nonterminal CondFactRelOpt CondFactRelOpt;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Factor, FactorSub, MulopFactorList, Term, AddopTermList, ExprBasic;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Expr, Type;
nonterminal rs.etf.pp1.symboltable.concepts.Obj DesignatorArrayName, Designator, DesignatorName, DesignatorPomArrayName, DesignatorMore, DesignatorPom, MethRetAndName;
nonterminal ForBegin ForBegin;
nonterminal ForEnd ForEnd;
nonterminal SwitchBegin SwitchBegin;
nonterminal SwitchEnd SwitchEnd;

nonterminal IfBegin IfBegin;
nonterminal IfAfterCond IfAfterCond;
nonterminal IfEnd IfEnd;

nonterminal TernaryQ TernaryQ;
nonterminal TernaryColon TernaryColon;
nonterminal TernaryEnd TernaryEnd;
nonterminal ForCondBegin ForCondBegin;
nonterminal CaseHdr CaseHdr;


precedence left ELSE;


/*Program = ʺprogramʺ ident {ConstDecl | VarDecl  | EnumDecl  } ʺ{ʺ {MethodDecl} ʺ}ʺ*/


Program ::= (Program) PROG ProgramName:P1 ConVarEnumDecList:C2 LBRACE MethodDeclList:M3 RBRACE {: RESULT=new Program(P1, C2, M3); RESULT.setLine(P1left); :};

ProgramName ::= (ProgramName) IDENT:I1 {: RESULT=new ProgramName(I1); RESULT.setLine(I1left); :};

ConVarEnumDecList ::= 	(ConVarEnumDecList_con) ConVarEnumDecList:C1 ConDecList:C2 {: RESULT=new ConVarEnumDecList_con(C1, C2); RESULT.setLine(C1left); :}
					|
					(ConVarEnumDecList_var) ConVarEnumDecList:C1 VarDeclList:V2 {: RESULT=new ConVarEnumDecList_var(C1, V2); RESULT.setLine(C1left); :}
					|
					(ConVarEnumDecList_enum) ConVarEnumDecList:C1 EnumDecl:E2 {: RESULT=new ConVarEnumDecList_enum(C1, E2); RESULT.setLine(C1left); :}
					|
					(ConVarEnumDecList_e) {: RESULT=new ConVarEnumDecList_e(); :} /* epsilon */
					;
					
/*ConstDecl = ʺconstʺ Type identʺ=ʺ(numConst | charConst | boolConst) {, ident ʺ=ʺ (numConst | charConst | boolConst)} ʺ;ʺ.*/					
					
ConDecList ::= (ConDecList) CONST Type:T1 ConDecl:C2 ConDeclMore:C3 SEMI {: RESULT=new ConDecList(T1, C2, C3); RESULT.setLine(T1left); :};

ConDecl ::= (ConDecl) IDENT:I1 EQUAL Constant:C2 {: RESULT=new ConDecl(I1, C2); RESULT.setLine(I1left); :};

ConDeclMore ::= (ConDeclMore_1) COMMA ConDecl:C1 ConDeclMore:C2 {: RESULT=new ConDeclMore_1(C1, C2); RESULT.setLine(C1left); :}
				|
				(ConDeclMore_e) {: RESULT=new ConDeclMore_e(); :} /* epsilon */
				;

Constant ::= 	(Constant_n) NUMBER:N1 {: RESULT=new Constant_n(N1); RESULT.setLine(N1left); :}
				|
				(Constant_c) CHARACTER:C1 {: RESULT=new Constant_c(C1); RESULT.setLine(C1left); :}
				|
				(Constant_b) BOOL:B1 {: RESULT=new Constant_b(B1); RESULT.setLine(B1left); :}
				;


/*VarDecl = Type ident [ʺ[ʺ ʺ]ʺ] {ʺ,ʺ ident [ʺ[ʺ ʺ]ʺ]} ʺ;ʺ */ 

VarDeclList ::= (VarDeclList) Type:T1 VarIdentList:V2 SEMI {: RESULT=new VarDeclList(T1, V2); RESULT.setLine(T1left); :} ; 

VarIdentList ::= 	(VarIdentList_one) VarIdent:V1 {: RESULT=new VarIdentList_one(V1); RESULT.setLine(V1left); :}
 					| 
 					(VarIdentList_more) VarIdentList:V1 COMMA VarIdent:V2 {: RESULT=new VarIdentList_more(V1, V2); RESULT.setLine(V1left); :}
 				 ; 
 				 
VarIdent ::= (VarIdent_1) IDENT:I1 {: RESULT=new VarIdent_1(I1); RESULT.setLine(I1left); :} | (VarIdent_more) IDENT:I1 LBRACKET RBRACKET {: RESULT=new VarIdent_more(I1); RESULT.setLine(I1left); :} ;


/*EnumDecl = "enum" ident "{" ident ["=" numConst] {"," ident ["=" numConst]} "}" */

EnumDecl ::= (EnumDecl)
              ENUM IDENT:I1 LBRACE EnumItemList:E2 RBRACE {: RESULT=new EnumDecl(I1, E2); RESULT.setLine(I1left); :};


EnumItemList ::= (EnumItemList_one)
                   EnumItem:E1 {: RESULT=new EnumItemList_one(E1); RESULT.setLine(E1left); :}
               |
                 (EnumItemList_more)
                   EnumItemList:E1 COMMA EnumItem:E2 {: RESULT=new EnumItemList_more(E1, E2); RESULT.setLine(E1left); :};


EnumItem ::= (EnumItem_simple)
               IDENT:I1 {: RESULT=new EnumItem_simple(I1); RESULT.setLine(I1left); :}
           |
             (EnumItem_value)
               IDENT:I1 EQUAL NUMBER:N2 {: RESULT=new EnumItem_value(I1, N2); RESULT.setLine(I1left); :};




/*MethodDecl = (Type | ʺvoidʺ) ident ʺ(ʺ [FormPars] ʺ)ʺ {VarDecl} ʺ{ʺ {Statement} ʺ}ʺ */
/*FormPars = Type ident [ʺ[ʺ ʺ]ʺ] {ʺ,ʺ Type ident [ʺ[ʺ ʺ]ʺ]} */
/* Type = ident */

Type ::= (Type) IDENT:I1 {: RESULT=new Type(I1); RESULT.setLine(I1left); :};

MethodDeclList ::= 	(MethodDeclList_list) MethodDeclList:M1  MethodDecl:M2 {: RESULT=new MethodDeclList_list(M1, M2); RESULT.setLine(M1left); :}
					|
					(MethodDeclList_e) {: RESULT=new MethodDeclList_e(); :}
					;

MethodDecl ::= (MethodDecl) MethRetAndName:M1 LPAREN FormParList:F2 RPAREN VarDeclListPom:V3 LBRACE StatementList:S4 RBRACE {: RESULT=new MethodDecl(M1, F2, V3, S4); RESULT.setLine(M1left); :};

MethRetAndName ::= 	(MethRetAndName_type) Type:T1 IDENT:I2 {: RESULT=new MethRetAndName_type(T1, I2); RESULT.setLine(T1left); :}
					|
					(MethRetAndName_void) VOID IDENT:I1 {: RESULT=new MethRetAndName_void(I1); RESULT.setLine(I1left); :}
					;
					
FormParList ::= 	(FormParList_form) FormPar:F1 FormParMore:F2 {: RESULT=new FormParList_form(F1, F2); RESULT.setLine(F1left); :}
					|
					(FormParList_e) {: RESULT=new FormParList_e(); :}
					;

FormParMore ::= (FormParMore_more) COMMA FormPar:F1 FormParMore:F2 {: RESULT=new FormParMore_more(F1, F2); RESULT.setLine(F1left); :}
				|
				(FormParMore_e) {: RESULT=new FormParMore_e(); :} /* epsilon */
				;
				
FormPar ::= (FormPar_var) Type:T1 IDENT:I2 {: RESULT=new FormPar_var(T1, I2); RESULT.setLine(T1left); :}  
			|
			(FormPar_array) Type:T1 IDENT:I2 LBRACKET RBRACKET {: RESULT=new FormPar_array(T1, I2); RESULT.setLine(T1left); :}
			; 


VarDeclListPom ::= 	(VarDeclListPom_pom) VarDeclListPom:V1 VarDeclList:V2 {: RESULT=new VarDeclListPom_pom(V1, V2); RESULT.setLine(V1left); :}
					|
					(VarDeclListPom_e) {: RESULT=new VarDeclListPom_e(); :} /* epsilon */
					;

/*Statement = DesignatorStatement ʺ;ʺ
| ʺifʺ ʺ(ʺ Condition ʺ)ʺ Statement [ʺelseʺ Statement]
| ʺbreakʺ ʺ;ʺ
| ʺcontinueʺ ʺ;ʺ
| ʺreturnʺ [Expr] ʺ;ʺ
| ʺreadʺ ʺ(ʺ Designator ʺ)ʺ ʺ;ʺ
| ʺprintʺ ʺ(ʺ Expr [ʺ,ʺ numConst] ʺ)ʺ ʺ;ʺ
| "switch" "(" Expr ")" "{" {"case" numConst ":" {Statement} } "}"
| "for" "(" [DesignatorStatement] ";" [Condition] ";" [DesignatorStatement] ")" Statement
| ʺ{ʺ {Statement} ʺ}ʺ */


StatementList ::=
      (StatementList_stat)
      StatementList:S1 Statement:S2 {: RESULT=new StatementList_stat(S1, S2); RESULT.setLine(S1left); :}
    |
      (StatementList_e) {: RESULT=new StatementList_e(); :}
      /* epsilon */
    ;

Statement ::=
      (Stmt_simple)
      SimpleStatement:S1 {: RESULT=new Stmt_simple(S1); RESULT.setLine(S1left); :}
    |
      (Stmt_s)
     Statements:S1 {: RESULT=new Stmt_s(S1); RESULT.setLine(S1left); :}
    ;

StatementElse ::=
      (StmtElse_simple)
      ELSE Statement:S1 {: RESULT=new StmtElse_simple(S1); RESULT.setLine(S1left); :}
    |
     (StmtElse_e) {: RESULT=new StmtElse_e(); :}
     /*epsilon*/
    ;
    
ForBegin ::= (ForBegin) {: RESULT=new ForBegin(); :} /* epsilon */ ;
ForEnd   ::= (ForEnd) {: RESULT=new ForEnd(); :}   /* epsilon */ ;

SwitchBegin ::= (SwitchBegin) {: RESULT=new SwitchBegin(); :} /* epsilon */ ;
SwitchEnd   ::= (SwitchEnd) {: RESULT=new SwitchEnd(); :}   /* epsilon */ ;

IfBegin      ::= (IfBegin) {: RESULT=new IfBegin(); :}      /* epsilon */ ;
IfAfterCond  ::= (IfAfterCond) {: RESULT=new IfAfterCond(); :}  /* epsilon */ ;
IfEnd        ::= (IfEnd) {: RESULT=new IfEnd(); :}        /* epsilon */ ;

TernaryQ     ::= (TernaryQ) {: RESULT=new TernaryQ(); :}     /* epsilon */ ;
TernaryColon ::= (TernaryColon) {: RESULT=new TernaryColon(); :} /* epsilon */ ;
TernaryEnd   ::= (TernaryEnd) {: RESULT=new TernaryEnd(); :}   /* epsilon */ ;

ForCondBegin ::= (ForCondBegin) {: RESULT=new ForCondBegin(); :} /* epsilon */ ;
    

SimpleStatement ::=
	(StmtNoElse_if)
	IF LPAREN IfBegin:I1 Condition:C2 RPAREN IfAfterCond:I3 Statement:S4 IfEnd:I5 StatementElse:S6 {: RESULT=new StmtNoElse_if(I1, C2, I3, S4, I5, S6); RESULT.setLine(I1left); :}
	|
 (Stmt_designator)
      DesignatorStatement:D1 SEMI {: RESULT=new Stmt_designator(D1); RESULT.setLine(D1left); :}

    | (Stmt_break)
      BREAK SEMI {: RESULT=new Stmt_break(); :}

    | (Stmt_continue)
      CONTINUE SEMI {: RESULT=new Stmt_continue(); :}

    | (Stmt_return)
      RETURN SEMI {: RESULT=new Stmt_return(); :}

    | (Stmt_return_expr)
      RETURN Expr:E1 SEMI {: RESULT=new Stmt_return_expr(E1); RESULT.setLine(E1left); :}

    | (Stmt_read)
      READ LPAREN Designator:D1 RPAREN SEMI {: RESULT=new Stmt_read(D1); RESULT.setLine(D1left); :}

    | (Stmt_print)
      PRINT LPAREN Expr:E1 RPAREN SEMI {: RESULT=new Stmt_print(E1); RESULT.setLine(E1left); :}

    | (Stmt_print_num)
      PRINT LPAREN Expr:E1 COMMA NUMBER:N2 RPAREN SEMI {: RESULT=new Stmt_print_num(E1, N2); RESULT.setLine(E1left); :}

 	| (Stmt_for)
  	FOR LPAREN ForInit:F1 SEMI ForCondBegin:F2 ForCond:F3 SEMI ForStep:F4 RPAREN ForBegin:F5 Statement:S6 ForEnd:F7 {: RESULT=new Stmt_for(F1, F2, F3, F4, F5, S6, F7); RESULT.setLine(F1left); :}

	| (Stmt_switch)
  	SWITCH LPAREN Expr:E1 RPAREN LBRACE SwitchBegin:S2 CaseList:C3 SwitchEnd:S4 RBRACE {: RESULT=new Stmt_switch(E1, S2, C3, S4); RESULT.setLine(E1left); :}
    ;
    
Statements ::= (Stmt_block)  LBRACE StatementList:S1 RBRACE {: RESULT=new Stmt_block(S1); RESULT.setLine(S1left); :} ;

ForInit ::=
      (ForInit_stmt)
      DesignatorStatement:D1 {: RESULT=new ForInit_stmt(D1); RESULT.setLine(D1left); :}
    |
      (ForInit_e) {: RESULT=new ForInit_e(); :}
      /* epsilon */
    ;

ForCond ::=
      (ForCond_cond)
      Condition:C1 {: RESULT=new ForCond_cond(C1); RESULT.setLine(C1left); :}
    |
      (ForCond_e) {: RESULT=new ForCond_e(); :}
      /* epsilon */
    ;

ForStep ::=
      (ForStep_stmt)
      DesignatorStatement:D1 {: RESULT=new ForStep_stmt(D1); RESULT.setLine(D1left); :}
    |
      (ForStep_e) {: RESULT=new ForStep_e(); :}
      /* epsilon */
    ;

CaseList ::=
      (CaseList_pom)
      CaseList:C1 CaseBlock:C2 {: RESULT=new CaseList_pom(C1, C2); RESULT.setLine(C1left); :}
    |
      (CaseList_e) {: RESULT=new CaseList_e(); :}
      /* epsilon */
    ;

CaseHdr ::= (CaseHdr) CASE NUMBER:N1 COLON {: RESULT=new CaseHdr(N1); RESULT.setLine(N1left); :} ;

CaseBlock ::= (CaseBlock) CaseHdr:C1 StatementList:S2 {: RESULT=new CaseBlock(C1, S2); RESULT.setLine(C1left); :} ;

/*DesignatorStatement = Designator (Assignop Expr | ʺ(ʺ [ActPars] ʺ)ʺ | ʺ++ʺ | ʺ�?�?ʺ)*/

DesignatorStatement ::=
      (DesStmt_assign)
      Designator:D1 Assignop:A2 Expr:E3 {: RESULT=new DesStmt_assign(D1, A2, E3); RESULT.setLine(D1left); :}
    |
      (DesStmt_call_noargs)
      Designator:D1 LPAREN RPAREN {: RESULT=new DesStmt_call_noargs(D1); RESULT.setLine(D1left); :}
    |
      (DesStmt_call_args)
      Designator:D1 LPAREN ActPars:A2 RPAREN {: RESULT=new DesStmt_call_args(D1, A2); RESULT.setLine(D1left); :}
    |
      (DesStmt_inc)
      Designator:D1 INC {: RESULT=new DesStmt_inc(D1); RESULT.setLine(D1left); :}
    |
      (DesStmt_dec)
      Designator:D1 DEC {: RESULT=new DesStmt_dec(D1); RESULT.setLine(D1left); :}
    ;

/*ActPars = Expr {ʺ,ʺ Expr}*/

ActPars ::=
      (ActPars_one) Expr:E1 ActParsMore:A2 {: RESULT=new ActPars_one(E1, A2); RESULT.setLine(E1left); :}
    ;

ActParsMore ::=
      (ActParsMore_comma) COMMA Expr:E1 ActParsMore:A2 {: RESULT=new ActParsMore_comma(E1, A2); RESULT.setLine(E1left); :}
    |
      (ActParsMore_e) {: RESULT=new ActParsMore_e(); :}
      /* epsilon */
    ;

/*Condition = CondTerm {ʺ||ʺ CondTerm}*/

Condition ::=     (Condition_or)  Condition:C1 OR CondTerm:C2 {: RESULT=new Condition_or(C1, C2); RESULT.setLine(C1left); :}
            |
                  (Condition_ct)  CondTerm:C1 {: RESULT=new Condition_ct(C1); RESULT.setLine(C1left); :}
            ;

/*CondTerm = CondFact {ʺ&&ʺ CondFact}*/
/* CondFact = Expr [Relop Expr] */

CondTerm ::=       (CondTerm_and) CondTerm:C1 AND CondFact:C2 {: RESULT=new CondTerm_and(C1, C2); RESULT.setLine(C1left); :}
            |
                  (CondTerm_cf)  CondFact:C1 {: RESULT=new CondTerm_cf(C1); RESULT.setLine(C1left); :}
            ;

CondFact ::=       (CondFact_main) ExprBasic:E1 CondFactRelOpt:C2 {: RESULT=new CondFact_main(E1, C2); RESULT.setLine(E1left); :}
            ;

CondFactRelOpt ::= (CondFactRelOpt_rel) Relop:R1 ExprBasic:E2 {: RESULT=new CondFactRelOpt_rel(R1, E2); RESULT.setLine(R1left); :}
            |
                   (CondFactRelOpt_e) {: RESULT=new CondFactRelOpt_e(); :}   /* epsilon */
            ;

/*Expr = ["-"] Term {Addop Term} | Condition "?" Expr ":" Expr */

Expr ::= (Expr_ternary) Condition:C1 QUESTION TernaryQ:T2 Expr:E3 COLON TernaryColon:T4 Expr:E5 TernaryEnd:T6 {: RESULT=new Expr_ternary(C1, T2, E3, T4, E5, T6); RESULT.setLine(C1left); :}
      | (Expr_basic)   ExprBasic:E1 {: RESULT=new Expr_basic(E1); RESULT.setLine(E1left); :}
      ;

ExprBasic ::=      (ExprBasic_main) AddopTermList:A1 {: RESULT=new ExprBasic_main(A1); RESULT.setLine(A1left); :}
            ;

AddopTermList ::= 	(AddopTermList_add) AddopTermList:A1 Addop:A2 Term:T3 {: RESULT=new AddopTermList_add(A1, A2, T3); RESULT.setLine(A1left); :}
					|
					(AddopTermList_term) Term:T1 {: RESULT=new AddopTermList_term(T1); RESULT.setLine(T1left); :}
					;
  

/*Term = Factor {Mulop Factor}*/


Term ::= (Term) MulopFactorList:M1 {: RESULT=new Term(M1); RESULT.setLine(M1left); :}
		 ;

MulopFactorList ::= (MulopFactorList_mul) MulopFactorList:M1 Mulop:M2 Factor:F3 {: RESULT=new MulopFactorList_mul(M1, M2, F3); RESULT.setLine(M1left); :}
					|
					(MulopFactorList_factor) Factor:F1 {: RESULT=new MulopFactorList_factor(F1); RESULT.setLine(F1left); :}
					;

/*Factor = Designator [ʺ(ʺ [ActPars] ʺ)ʺ]
| numConst
| charConst
| boolConst
| ʺnewʺ Type ʺ[ʺ Expr ʺ]ʺ
| ʺ(ʺ Expr ʺ)ʺ*/

Factor ::= (Factor) Pom:P1 FactorSub:F2 {: RESULT=new Factor(P1, F2); RESULT.setLine(P1left); :};

Pom ::= 	(Pom_m) MINUS {: RESULT=new Pom_m(); :}
			|
			(Pom_e) {: RESULT=new Pom_e(); :} /* epsilon */
			;

FactorSub ::=
      (Factor_design) Designator:D1 FactorOptActPars:F2 {: RESULT=new Factor_design(D1, F2); RESULT.setLine(D1left); :}
    |
      (Factor_num) NUMBER:N1 {: RESULT=new Factor_num(N1); RESULT.setLine(N1left); :}
    |
      (Factor_char) CHARACTER:C1 {: RESULT=new Factor_char(C1); RESULT.setLine(C1left); :}
    |
      (Factor_bool) BOOL:B1 {: RESULT=new Factor_bool(B1); RESULT.setLine(B1left); :}
    |
      (Factor_new_arr) NEW Type:T1 LBRACKET Expr:E2 RBRACKET {: RESULT=new Factor_new_arr(T1, E2); RESULT.setLine(T1left); :}
    |
      (Factor_paren) LPAREN Expr:E1 RPAREN {: RESULT=new Factor_paren(E1); RESULT.setLine(E1left); :}
    ;

FactorOptActPars ::=
      (FactorOpt_call_noargs) LPAREN RPAREN {: RESULT=new FactorOpt_call_noargs(); :}
    |
      (FactorOpt_call_args)   LPAREN ActPars:A1 RPAREN {: RESULT=new FactorOpt_call_args(A1); RESULT.setLine(A1left); :}
    |
      (FactorOpt_e) {: RESULT=new FactorOpt_e(); :}
      /* epsilon */
    ;

/*Designator = ident {ʺ.ʺ ( ident | "length") | ʺ[ʺ Expr ʺ]ʺ}*/

Designator ::= 	(Designator_var) IDENT:I1 {: RESULT=new Designator_var(I1); RESULT.setLine(I1left); :}
				|
				(Designator_elem) DesignatorArrayName:D1 LBRACKET Expr:E2 RBRACKET {: RESULT=new Designator_elem(D1, E2); RESULT.setLine(D1left); :}
				|
				(Designator_pom) DesignatorName:D1 DesignatorMore:D2 {: RESULT=new Designator_pom(D1, D2); RESULT.setLine(D1left); :}
				|
				(Designator_pom_elem) DesignatorPom:D1 DesignatorMore:D2 {: RESULT=new Designator_pom_elem(D1, D2); RESULT.setLine(D1left); :}
				;
				
DesignatorPom ::= (DesignatorPom) DesignatorArrayName:D1 LBRACKET Expr:E2 RBRACKET {: RESULT=new DesignatorPom(D1, E2); RESULT.setLine(D1left); :}
				;			
				
DesignatorMore ::= 	(DesignatorMore_var) DOT IDENT:I1 {: RESULT=new DesignatorMore_var(I1); RESULT.setLine(I1left); :} 
						|
					 	(DesignatorMore_elem) DOT DesignatorPomArrayName:D1 LBRACKET Expr:E2 RBRACKET {: RESULT=new DesignatorMore_elem(D1, E2); RESULT.setLine(D1left); :} 
						|
                        (DesignatorMore_length) DOT LENGTH {: RESULT=new DesignatorMore_length(); :}
                        |
						(DesignatorMore_pom_var) DesignatorMore:D1 DOT IDENT:I2 {: RESULT=new DesignatorMore_pom_var(D1, I2); RESULT.setLine(D1left); :}
						|
						(DesignatorMore_pom_elem) DesignatorMore:D1  DOT DesignatorPomArrayName:D2 LBRACKET Expr:E3 RBRACKET {: RESULT=new DesignatorMore_pom_elem(D1, D2, E3); RESULT.setLine(D1left); :}
                        |
                        (DesignatorMore_pom_length) DesignatorMore:D1 DOT LENGTH {: RESULT=new DesignatorMore_pom_length(D1); RESULT.setLine(D1left); :}
						;

						
DesignatorArrayName ::= (DesignatorArrayName) IDENT:I1 {: RESULT=new DesignatorArrayName(I1); RESULT.setLine(I1left); :};
DesignatorName ::= (DesignatorName) IDENT:I1 {: RESULT=new DesignatorName(I1); RESULT.setLine(I1left); :};
DesignatorPomArrayName ::= (DesignatorPomArrayName) IDENT:I1 {: RESULT=new DesignatorPomArrayName(I1); RESULT.setLine(I1left); :};


/*Assignop = ʺ=ʺ*/

Assignop ::=
      (Assignop_eq) EQUAL {: RESULT=new Assignop_eq(); :}
    ;

/*Relop = ʺ==ʺ | ʺ!=ʺ | ʺ>ʺ | ʺ>=ʺ | ʺ<ʺ | ʺ<=ʺ*/

Relop ::=
      (Relop_eq) EQ {: RESULT=new Relop_eq(); :}
    |
      (Relop_ne) NE {: RESULT=new Relop_ne(); :}
    |
      (Relop_gt) GT {: RESULT=new Relop_gt(); :}
    |
      (Relop_ge) GE {: RESULT=new Relop_ge(); :}
    |
      (Relop_lt) LT {: RESULT=new Relop_lt(); :}
    |
      (Relop_le) LE {: RESULT=new Relop_le(); :}
    ;

/*Addop = ʺ+ʺ | ʺ�?ʺ*/

Addop ::=
      (Addop_plus) PLUS {: RESULT=new Addop_plus(); :}
    |
      (Addop_minus) MINUS {: RESULT=new Addop_minus(); :}
    ;


/*Mulop = ʺ*ʺ | ʺ/ʺ | ʺ%ʺ */

Mulop ::=
      (Mulop_mul) MUL {: RESULT=new Mulop_mul(); :}
    |
      (Mulop_div) DIV {: RESULT=new Mulop_div(); :}
    |
      (Mulop_mod) MOD {: RESULT=new Mulop_mod(); :}
    ;



